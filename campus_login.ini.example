# =====================================================
# 校园网自动登录 配置文件示例
# 使用方法：复制本文件为 campus_login.ini，按下面说明填写后保存。
#   本文件（*.example）可以提交到仓库；
#   campus_login.ini 含真实账号密码，已在 .gitignore 中，切勿上传。
# =====================================================

[account]
# 校园网认证账号（一般是学号）
user_id = 你的账号
# 校园网认证密码
password = 你的密码

# -----------------------------------------------------
# 网关参数：以下三项与你的设备/网络相关，默认留空即可，
# 程序会自动探测（出口 IP、主机名、MAC）。
# 只有当自动探测的结果与浏览器认证地址中的参数不一致、
# 导致登录失败时，才需要手动抓包后在这里固定填写。
# -----------------------------------------------------
[gateway]
# 认证网关地址（一般不用改）
base_url = http://172.16.253.121/quickauth.do

# 以下三项留空 = 自动获取；如需固定，请去掉行首 # 并填写
# wlanuserip = 192.168.x.x
# mac = 00:00:00:00:00:00
# hostname = YOUR-PC

# 以下为学校认证网关的固定参数，内置默认已可用，通常无需修改；
# 若换校区/换网络后认证地址里这些值不同，再在此覆盖。
# wlanacname = NFV-BASE-SGYD
# wlanaclp = 172.16.253.113
# vlan = 194
# portalpageid = 2
# bindOperatorType = 2

# -----------------------------------------------------
# 运行参数（可选，不写就使用内置默认值）
# -----------------------------------------------------
[settings]
# 网络检测间隔（秒），默认 30
check_interval = 30
# 登录请求超时（秒），默认 10
login_timeout = 10
# 联网探测单站点超时（秒），默认 3
check_timeout = 3
# 一轮登录最多尝试次数，默认 3
max_retry = 3
# 重试退避基数（秒），实际等待 5 -> 10 -> 20 指数递增，默认 5
retry_backoff = 5
# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO
log_level = INFO
